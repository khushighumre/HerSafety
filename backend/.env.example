# Comma-separated list of allowed frontend origins.
# The frontend dev server runs on http://localhost:8080 by default.
# Add additional origins if your setup differs (e.g. a deployed preview URL).
BACKEND_CORS_ORIGINS=http://localhost:8080

# SQLite database file path (relative to backend/).
# Default: backend/nightwise.db — override only if you need a different location.
# DATABASE_URL=sqlite:///./nightwise.db

# OpenRouteService API key for live routing and geocoding.
# Get a free API key at https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=

# OpenStreetMap / Overpass API configuration (no API key required).
# OVERPASS_ENDPOINT defaults to the primary public Overpass interpreter.
# OVERPASS_FALLBACK_ENDPOINT is used if the primary endpoint times out or fails.
# Alternative public mirrors:
#   https://overpass-api.de/api/interpreter
#   https://overpass.kumi.systems/api/interpreter
#   https://overpass.private.coffee/api/interpreter
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_ENDPOINT=https://overpass.kumi.systems/api/interpreter
OVERPASS_TIMEOUT_SEC=6.0
OVERPASS_COOLDOWN_SEC=60.0
OVERPASS_CACHE_TTL_SEC=1800.0
OVERPASS_MAX_CACHE_SIZE=200
OVERPASS_MAX_BBOX_SPAN=0.25

# Open Government Data Platform India (data.gov.in) Configuration
# API key obtained by registering for free on https://data.gov.in (My Account page)
DATA_GOV_IN_API_KEY=
# Resource ID (UUID) of the target official NCRB crime statistics table
DATA_GOV_IN_RESOURCE_ID=
DATA_GOV_IN_ENDPOINT=https://api.data.gov.in/resource
DATA_GOV_IN_TIMEOUT_SEC=8.0


